; Engine configuration file.
; Five Ball Grand Slam — M0 tooling scaffold only.
config_version=5

[application]
config/name="Five Ball Grand Slam"
run/main_scene="res://scenes/technical_table.tscn"
config/features=PackedStringArray("4.7")

[display]
window/size/viewport_width=1365
window/size/viewport_height=768
window/size/window_width_override=1365
window/size/window_height_override=768
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.027, 0.043, 0.067, 1)
